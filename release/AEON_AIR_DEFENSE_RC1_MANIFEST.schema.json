{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeon/release/AEON_AIR_DEFENSE_RC1_MANIFEST.schema.json",
  "title": "Aeon release-candidate manifest",
  "type": "object",
  "required": [
    "product", "release_id", "source_commit", "source_branch",
    "repository_url", "build_toolchain", "build_timestamp",
    "package_profiles", "sbom_index", "test_totals",
    "gate_decisions", "scope_boundary", "known_limitations_ref",
    "sponsor_validation_ref", "sponsor_validation_status",
    "accreditation_disclaimer", "release_rating",
    "evidence_generation_commands"
  ],
  "additionalProperties": true,
  "properties": {
    "product":       { "const": "aeon-air-defense-information-layer" },
    "release_id":    { "type": "string", "pattern": "^aeon-air-defense-rc[0-9]+$" },
    "source_commit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "source_branch": { "type": "string" },
    "repository_url":{ "type": "string" },
    "build_toolchain": {
      "type": "object",
      "required": ["rustc","cargo","rustfmt","clippy","cargo-audit","cargo-cyclonedx","gitleaks"]
    },
    "build_timestamp": { "type": "string" },
    "package_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["profile","path","manifest","manifest_sha256","package_tree_sha256","sbom_count"]
      }
    },
    "sbom_index":   { "type": "array" },
    "test_totals":  { "type": "object",
      "required": ["unit_property_integration_adversarial","deployment_negative_path","total","failures","skips"] },
    "gate_decisions": {
      "type": "object",
      "required": ["gate_10","gate_11a","gate_11b","gate_11_overall"]
    },
    "scope_boundary": {
      "type": "object",
      "required": [
        "static_scan","runtime_content_scan","relay_message_kinds_count",
        "no_weapon_control","no_firing_solution","no_launch_or_guidance",
        "no_aimpoint_or_engagement"
      ]
    },
    "known_limitations_ref":    { "type": "string" },
    "sponsor_validation_ref":   { "type": "string" },
    "sponsor_validation_status":{ "type": "string" },
    "accreditation_disclaimer": { "type": "string" },
    "release_rating":           { "type": "string" },
    "evidence_generation_commands": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  }
}
