{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeon/verification/verification-requirements.schema.json",
  "title": "Aeon verification-requirements manifest",
  "type": "object",
  "required": ["manifest_version", "steps"],
  "additionalProperties": false,
  "properties": {
    "manifest_version": { "type": "integer", "minimum": 1 },
    "notes":            { "type": "string" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "command", "mandatory", "failure_semantics"],
        "additionalProperties": false,
        "properties": {
          "step_id":                { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
          "description":            { "type": "string" },
          "command":                { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "mandatory":              { "type": "boolean" },
          "expected_artifact":      { "type": "string" },
          "minimum_test_count":     { "type": "integer", "minimum": 0 },
          "platforms":              { "type": "array", "items": { "type": "string" } },
          "not_applicable_reason":  { "type": "string" },
          "failure_semantics":      { "enum": ["fail_closed", "advisory_only"] },
          "environment":            { "type": "object" }
        }
      }
    }
  }
}
