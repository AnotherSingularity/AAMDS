{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aeon/deployment/package-manifest.v2.schema.json",
  "title": "Aeon canonical package manifest (v2, RC2)",
  "type": "object",
  "required": [
    "manifest_version", "product", "release_version", "source_commit",
    "profile", "target_os", "target_arch",
    "build_identity", "toolchain_identity", "files",
    "sbom", "signing_policy", "scope_policy", "signature"
  ],
  "additionalProperties": false,
  "properties": {
    "manifest_version": { "type": "integer", "const": 2 },
    "product":          { "type": "string" },
    "release_version":  { "type": "string" },
    "source_commit":    { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "profile":          { "enum": ["developer","edge","fixed-site","disconnected","data-center","private-cloud"] },
    "target_os":        { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "target_arch":      { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "build_identity":   { "type": "object" },
    "toolchain_identity": { "type": "object" },
    "created_at":       { "type": "string" },
    "files": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256", "content_role", "executable", "required"],
        "additionalProperties": false,
        "properties": {
          "path":         { "type": "string" },
          "size":         { "type": "integer", "minimum": 0 },
          "sha256":       { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "content_role": { "enum": ["executable","script","config","schema","documentation","sbom","identity","migration","ui","other"] },
          "executable":   { "type": "boolean" },
          "required":     { "type": "boolean" }
        }
      }
    },
    "sbom":               { "type": "array", "items": { "type": "string" } },
    "configuration_schema": { "type": "array", "items": { "type": "string" } },
    "migration_set":      { "type": "array", "items": { "type": "string" } },
    "signing_policy":     { "type": "object" },
    "scope_policy":       { "type": "object" },
    "signature": {
      "type": "object",
      "required": ["method", "key_id", "over"],
      "additionalProperties": false,
      "properties": {
        "method":    { "enum": ["dev-hmac-sha256", "kms-hsm"] },
        "key_id":    { "type": "string" },
        "over":      { "type": "string", "const": "canonical-manifest-minus-signature" },
        "signature_hex": { "type": "string" },
        "note":      { "type": "string" }
      }
    }
  }
}
